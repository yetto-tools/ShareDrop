{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShareDrop",
  "version": "0.1.0",
  "identifier": "com.erashon.sharedrop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ShareDrop",
        "width": 520,
        "height": 700,
        "minWidth": 420,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sharedrop"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "publisher": "ShareDrop",
    "shortDescription": "ShareDrop - archivos entre tu celular y tu PC, sin internet",
    "longDescription": "ShareDrop comparte archivos entre un celular Android y una laptop por la red local, sin internet ni nube. Usa TCP 47800 y UDP 47801.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
